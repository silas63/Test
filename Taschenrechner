import streamlit as st

# ============================================================
# APPLE-STYLE TASCHENRECHNER FÜR STREAMLIT
# ============================================================

st.set_page_config(
    page_title="Taschenrechner",
    page_icon="🧮",
    layout="centered",
)

# ------------------------------------------------------------
# SESSION STATE
# ------------------------------------------------------------

if "display" not in st.session_state:
    st.session_state.display = "0"

if "number" not in st.session_state:
    st.session_state.number = None

if "operator" not in st.session_state:
    st.session_state.operator = None

if "new_number" not in st.session_state:
    st.session_state.new_number = False


# ------------------------------------------------------------
# BERECHNUNGEN
# ------------------------------------------------------------

def get_value():
    try:
        return float(st.session_state.display.replace(",", "."))
    except:
        return 0


def format_number(number):
    if number == int(number):
        return str(int(number))

    result = f"{number:.10f}".rstrip("0").rstrip(".")

    return result.replace(".", ",")


def number_pressed(value):

    if st.session_state.new_number:
        st.session_state.display = value
        st.session_state.new_number = False

    elif st.session_state.display == "0":
        st.session_state.display = value

    else:
        st.session_state.display += value


def decimal_pressed():

    if st.session_state.new_number:
        st.session_state.display = "0,"
        st.session_state.new_number = False

    elif "," not in st.session_state.display:
        st.session_state.display += ","


def operator_pressed(operator):

    current = get_value()

    if (
        st.session_state.number is not None
        and st.session_state.operator is not None
        and not st.session_state.new_number
    ):
        calculate()

        current = get_value()

    st.session_state.number = current
    st.session_state.operator = operator
    st.session_state.new_number = True


def calculate():

    if (
        st.session_state.number is None
        or st.session_state.operator is None
    ):
        return

    first = st.session_state.number
    second = get_value()
    operator = st.session_state.operator

    try:

        if operator == "+":
            result = first + second

        elif operator == "−":
            result = first - second

        elif operator == "×":
            result = first * second

        elif operator == "÷":

            if second == 0:
                st.session_state.display = "Fehler"
                reset()
                return

            result = first / second

        else:
            return

        st.session_state.display = format_number(result)

        st.session_state.number = None
        st.session_state.operator = None
        st.session_state.new_number = True

    except:
        st.session_state.display = "Fehler"
        reset()


def reset():

    st.session_state.number = None
    st.session_state.operator = None
    st.session_state.new_number = True


def clear():

    st.session_state.display = "0"
    st.session_state.number = None
    st.session_state.operator = None
    st.session_state.new_number = False


def change_sign():

    if st.session_state.display == "0":
        return

    if st.session_state.display.startswith("-"):
        st.session_state.display = st.session_state.display[1:]

    else:
        st.session_state.display = "-" + st.session_state.display


def percent():

    try:
        value = get_value()
        value = value / 100
        st.session_state.display = format_number(value)

    except:
        st.session_state.display = "Fehler"


