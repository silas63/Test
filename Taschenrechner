import tkinter as tk
import math

# ============================================================
# Apple-inspirierter Taschenrechner
# ============================================================

class Calculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Taschenrechner")
        self.root.geometry("380x620")
        self.root.resizable(False, False)
        self.root.configure(bg="#000000")

        self.current = "0"
        self.previous = None
        self.operator = None
        self.reset_next = False

        # ----------------------------------------------------
        # Display
        # ----------------------------------------------------
        self.display = tk.Label(
            root,
            text="0",
            bg="#000000",
            fg="white",
            font=("Helvetica", 48),
            anchor="e",
            padx=20
        )
        self.display.pack(
            fill="both",
            expand=True,
            pady=(20, 10)
        )

        # ----------------------------------------------------
        # Button-Bereich
        # ----------------------------------------------------
        button_frame = tk.Frame(
            root,
            bg="#000000"
        )
        button_frame.pack(
            fill="both",
            expand=True,
            padx=10,
            pady=10
        )

        # Button-Farben
        number_color = "#333333"
        number_pressed = "#555555"

        function_color = "#A5A5A5"
        function_pressed = "#D0D0D0"

        operator_color = "#FF9500"
        operator_pressed = "#FFB340"

        text_dark = "#000000"
        text_light = "#FFFFFF"

        # ----------------------------------------------------
        # Button-Konfiguration
        # ----------------------------------------------------
        buttons = [
            ("AC", 0, 0, function_color, function_pressed, text_dark),
            ("+/-", 0, 1, function_color, function_pressed, text_dark),
            ("%", 0, 2, function_color, function_pressed, text_dark),
            ("÷", 0, 3, operator_color, operator_pressed, text_light),

            ("7", 1, 0, number_color, number_pressed, text_light),
            ("8", 1, 1, number_color, number_pressed, text_light),
            ("9", 1, 2, number_color, number_pressed, text_light),
            ("×", 1, 3, operator_color, operator_pressed, text_light),

            ("4", 2, 0, number_color, number_pressed, text_light),
            ("5", 2, 1, number_color, number_pressed, text_light),
            ("6", 2, 2, number_color, number_pressed, text_light),
            ("−", 2, 3, operator_color, operator_pressed, text_light),

            ("1", 3, 0, number_color, number_pressed, text_light),
            ("2", 3, 1, number_color, number_pressed, text_light),
            ("3", 3, 2, number_color, number_pressed, text_light),
            ("+", 3, 3, operator_color, operator_pressed, text_light),

            ("0", 4, 0, number_color, number_pressed, text_light),
            (",", 4, 2, number_color, number_pressed, text_light),
            ("=", 4, 3, operator_color, operator_pressed, text_light),
        ]

        self.buttons = {}

        # ----------------------------------------------------
        # Buttons erstellen
        # ----------------------------------------------------
        for text, row, col, bg, pressed_bg, fg in buttons:

            # 0 soll über zwei Spalten gehen
            if text == "0":
                button = tk.Button(
                    button_frame,
                    text=text,
                    font=("Helvetica", 26),
                    bg=bg,
                    fg=fg,
                    activebackground=pressed_bg,
                    activeforeground=fg,
                    bd=0,
                    relief="flat",
                    command=lambda t=text: self.button_pressed(t)
                )

                button.grid(
                    row=row,
                    column=0,
                    columnspan=2,
                    sticky="nsew",
                    padx=5,
                    pady=5
                )

            else:
                button = tk.Button(
                    button_frame,
                    text=text,
                    font=("Helvetica", 26),
                    bg=bg,
                    fg=fg,
                    activebackground=pressed_bg,
                    activeforeground=fg,
                    bd=0,
                    relief="flat",
                    command=lambda t=text: self.button_pressed(t)
                )

                button.grid(
                    row=row,
                    column=col,
                    sticky="nsew",
                    padx=5,
                    pady=5
                )

            self.buttons[text] = button

        # Leere Position in der letzten Reihe
        empty = tk.Label(
            button_frame,
            bg="#000000"
        )
        empty.grid(row=4, column=1)

        # ----------------------------------------------------
        # Gleichmäßige Größen
        # ----------------------------------------------------
        for row in range(5):
            button_frame.rowconfigure(row, weight=1)

        for col in range(4):
            button_frame.columnconfigure(col, weight=1)

        # Tastatursteuerung
        root.bind("<Key>", self.keyboard_input)

    # ========================================================
    # Button-Effekt
    # ========================================================

    def haptic_feedback(self, button):
        """
        Simuliert haptisches Feedback.
        Auf einem normalen PC gibt es keine echte iPhone-Haptik,
        deshalb wird die Taste kurz optisch verändert.
        """

        original = button.cget("bg")

        if original == "#333333":
            pressed = "#555555"
        elif original == "#FF9500":
            pressed = "#FFB340"
        else:
            pressed = "#D0D0D0"

        button.config(bg=pressed)

        self.root.after(
            80,
            lambda: button.config(bg=original)
        )

        # System-Beep als zusätzliche Rückmeldung
        try:
            self.root.bell()
        except:
            pass

    # ========================================================
    # Button verarbeitet
    # ========================================================

    def button_pressed(self, value):

        # Haptik
        if value in self.buttons:
            self.haptic_feedback(self.buttons[value])

        # Zahlen
        if value.isdigit():
            self.enter_number(value)

        elif value == ",":
            self.enter_decimal()

        elif value in ["+", "−", "×", "÷"]:
            self.choose_operator(value)

        elif value == "=":
            self.calculate()

        elif value == "AC":
            self.clear()

        elif value == "+/-":
            self.change_sign()

        elif value == "%":
            self.percent()

    # ========================================================
    # Zahl eingeben
    # ========================================================

    def enter_number(self, number):

        if self.reset_next:
            self.current = number
            self.reset_next = False

        elif self.current == "0":
            self.current = number

        else:
            self.current += number

        self.update_display()

    # ========================================================
    # Komma
    # ========================================================

    def enter_decimal(self):

        if self.reset_next:
            self.current = "0,"
            self.reset_next = False

        elif "," not in self.current:
            self.current += ","

        self.update_display()

    # ========================================================
    # Operator auswählen
    # ========================================================

    def choose_operator(self, operator):

        if self.previous is not None and self.operator and not self.reset_next:
            self.calculate()

        self.previous = self.to_number(self.current)
        self.operator = operator
        self.reset_next = True

    # ========================================================
    # Berechnung
    # ========================================================

    def calculate(self):

        if self.previous is None or self.operator is None:
            return

        current_number = self.to_number(self.current)

        try:

            if self.operator == "+":
                result = self.previous + current_number

            elif self.operator == "−":
                result = self.previous - current_number

            elif self.operator == "×":
                result = self.previous * current_number

            elif self.operator == "÷":
                if current_number == 0:
                    self.current = "Fehler"
                    self.previous = None
                    self.operator = None
                    self.reset_next = True
                    self.update_display()
                    return

                result = self.previous / current_number

            self.current = self.format_number(result)

            self.previous = None
            self.operator = None
            self.reset_next = True

            self.update_display()

        except Exception:
            self.current = "Fehler"
            self.previous = None
            self.operator = None
            self.reset_next = True
            self.update_display()

    # ========================================================
    # Alles löschen
    # ========================================================

    def clear(self):

        self.current = "0"
        self.previous = None
        self.operator = None
        self.reset_next = False

        self.update_display()

    # ========================================================
    # Vorzeichen ändern
    # ========================================================

    def change_sign(self):

        if self.current == "0" or self.current == "Fehler":
            return

        if self.current.startswith("-"):
            self.current = self.current[1:]
        else:
            self.current = "-" + self.current

        self.update_display()

    # ========================================================
    # Prozent
    # ========================================================

    def percent(self):

        try:
            number = self.to_number(self.current)
            number = number / 100

            self.current = self.format_number(number)

            self.update_display()

        except:
            self.current = "Fehler"
            self.update_display()

    # ========================================================
    # Zahl umwandeln
    # ========================================================

    def to_number(self, value):

        value = value.replace(",", ".")

        return float(value)

    # ========================================================
    # Zahl formatieren
    # ========================================================

    def format_number(self, number):

        if number.is_integer():
            return str(int(number))

        # Verhindert zu viele Nachkommastellen
        formatted = f"{number:.10f}".rstrip("0").rstrip(".")

        return formatted.replace(".", ",")

    # ========================================================
    # Display aktualisieren
    # ========================================================

    def update_display(self):

        self.display.config(
            text=self.current
        )

    # ========================================================
    # Tastatur
    # ========================================================

    def keyboard_input(self, event):

        key = event.keysym
        char = event.char

        if char.isdigit():
            self.enter_number(char)

        elif char in [".", ","]:
            self.enter_decimal()

        elif char == "+":
            self.choose_operator("+")

        elif char == "-":
            self.choose_operator("−")

        elif char == "*":
            self.choose_operator("×")

        elif char == "/":
            self.choose_operator("÷")

        elif char == "%":
            self.percent()

        elif key in ["Return", "KP_Enter"]:
            self.calculate()

        elif key == "Escape":
            self.clear()


# ============================================================
# Programm starten
# ============================================================

if __name__ == "__main__":

    root = tk.Tk()

    calculator = Calculator(root)

    root.mainloop()
