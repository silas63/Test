import streamlit as st
import streamlit.components.v1 as components

# ============================================================
# STREAMLIT APP
# ============================================================

st.set_page_config(
    page_title="Taschenrechner",
    page_icon="🧮",
    layout="centered"
)

# ============================================================
# SESSION STATE
# ============================================================

if "display" not in st.session_state:
    st.session_state.display = "0"

if "first_number" not in st.session_state:
    st.session_state.first_number = None

if "operator" not in st.session_state:
    st.session_state.operator = None

if "new_number" not in st.session_state:
    st.session_state.new_number = False


# ============================================================
# FUNKTIONEN
# ============================================================

def haptic():
    """
    Web-Haptik über die Browser Vibration API.
    Funktioniert nur auf unterstützten Geräten/Browsers.
    """

    components.html(
        """
        <script>
            if (navigator.vibrate) {
                navigator.vibrate(20);
            }
        </script>
        """,
        height=0
    )


def enter_number(number):
    haptic()

    if st.session_state.new_number:
        st.session_state.display = number
        st.session_state.new_number = False

    elif st.session_state.display == "0":
        st.session_state.display = number

    else:
        st.session_state.display += number


def enter_decimal():
    haptic()

    if st.session_state.new_number:
        st.session_state.display = "0,"
        st.session_state.new_number = False

    elif "," not in st.session_state.display:
        st.session_state.display += ","


def choose_operator(operator):
    haptic()

    try:
        number = float(
            st.session_state.display.replace(",", ".")
        )

        # Falls bereits eine Operation läuft
        if (
            st.session_state.first_number is not None
            and st.session_state.operator is not None
            and not st.session_state.new_number
        ):
            calculate()

            number = float(
                st.session_state.display.replace(",", ".")
            )

        st.session_state.first_number = number
        st.session_state.operator = operator
        st.session_state.new_number = True

    except ValueError:
        st.session_state.display = "Fehler"


def calculate():
    haptic()

    if (
        st.session_state.first_number is None
        or st.session_state.operator is None
    ):
        return

    try:
        second_number = float(
            st.session_state.display.replace(",", ".")
        )

        first_number = st.session_state.first_number
        operator = st.session_state.operator

        if operator == "+":
            result = first_number + second_number

        elif operator == "−":
            result = first_number - second_number

        elif operator == "×":
            result = first_number * second_number

        elif operator == "÷":

            if second_number == 0:
                st.session_state.display = "Fehler"
                reset_calculator()
                return

            result = first_number / second_number

        else:
            return

        st.session_state.display = format_number(result)

        st.session_state.first_number = None
        st.session_state.operator = None
        st.session_state.new_number = True

    except Exception:
        st.session_state.display = "Fehler"
        reset_calculator()


def reset_calculator():
    st.session_state.first_number = None
    st.session_state.operator = None
    st.session_state.new_number = True


def clear():
    haptic()

    st.session_state.display = "0"
    st.session_state.first_number = None
    st.session_state.operator = None
    st.session_state.new_number = False


def change_sign():
    haptic()

    if st.session_state.display == "0":
        return

    if st.session_state.display.startswith("-"):
        st.session_state.display = (
            st.session_state.display[1:]
        )
    else:
        st.session_state.display = (
            "-" + st.session_state.display
        )


def percent():
    haptic()

    try:
        number = float(
            st.session_state.display.replace(",", ".")
        )

        number /= 100

        st.session_state.display = format_number(number)

    except:
        st.session_state.display = "Fehler"


def format_number(number):

    if number.is_integer():
        return str(int(number))

    result = f"{number:.10f}".rstrip("0").rstrip(".")

    return result.replace(".", ",")


