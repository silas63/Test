import streamlit as st
import streamlit.components.v1 as components


# ============================================================
# SEITENKONFIGURATION
# ============================================================

st.set_page_config(
    page_title="Apple Calculator",
    page_icon="🧮",
    layout="centered",
    initial_sidebar_state="collapsed",
)


# ============================================================
# SESSION STATE
# ============================================================

defaults = {
    "display": "0",
    "stored_value": None,
    "operator": None,
    "waiting_for_number": False,
}

for key, value in defaults.items():
    if key not in st.session_state:
        st.session_state[key] = value


# ============================================================
# HAPTISCHES FEEDBACK
# ============================================================

def haptic():
    """
    Kurze Vibration auf unterstützten Smartphones.
    """

    components.html(
        """
        <script>
            try {
                if (navigator.vibrate) {
                    navigator.vibrate(18);
                }
            } catch (e) {}
        </script>
        """,
        height=0,
    )


# ============================================================
# HILFSFUNKTIONEN
# ============================================================

def get_number():
    try:
        return float(st.session_state.display.replace(",", "."))
    except ValueError:
        return 0.0


def format_number(value):
    if value == 0:
        return "0"

    if value.is_integer():
        return str(int(value))

    text = f"{value:.10f}".rstrip("0").rstrip(".")

    return text.replace(".", ",")


def reset_operation():
    st.session_state.stored_value = None
    st.session_state.operator = None
    st.session_state.waiting_for_number = False


# ============================================================
# ZAHLEN
# ============================================================

def press_number(number):
    haptic()

    if st.session_state.waiting_for_number:
        st.session_state.display = number
        st.session_state.waiting_for_number = False
        return

    if st.session_state.display == "0":
        st.session_state.display = number
    else:
        st.session_state.display += number


# ============================================================
# KOMMA
# ============================================================

def press_decimal():
    haptic()

    if st.session_state.waiting_for_number:
        st.session_state.display = "0,"
        st.session_state.waiting_for_number = False
        return

    if "," not in st.session_state.display:
        st.session_state.display += ","


# ============================================================
# OPERATOR
# ============================================================

def press_operator(operator):
    haptic()

    current = get_number()

    if (
        st.session_state.stored_value is not None
        and st.session_state.operator is not None
        and not st.session_state.waiting_for_number
    ):
        calculate()

        current = get_number()

    st.session_state.stored_value = current
    st.session_state.operator = operator
    st.session_state.waiting_for_number = True


# ============================================================
# BERECHNEN
# ============================================================

def calculate():
    haptic()

    if (
        st.session_state.stored_value is None
        or st.session_state.operator is None
    ):
        return

    first = st.session_state.stored_value
    second = get_number()
    operator = st.session_state.operator

    try:

        if operator == "+":
            result = first + second

        elif operator == "−":
            result = first - second

        elif operator == "×":
            result = first * second

        elif operator == "÷":

            if second == 0:
                st.session_state.display = "Fehler"
                reset_operation()
                return

            result = first / second

        else:
            return

        st.session_state.display = format_number(result)

        reset_operation()

        st.session_state.waiting_for_number = True

    except Exception:
        st.session_state.display = "Fehler"
        reset_operation()


# ============================================================
# AC
# ============================================================

def clear():
    haptic()

    st.session_state.display = "0"

    reset_operation()


# ============================================================
# VORZEICHEN
# ============================================================

def change_sign():
    haptic()

    if st.session_state.display == "0":
        return

    if st.session_state.display.startswith("-"):
        st.session_state.display = st.session_state.display[1:]
    else:
        st.session_state.display = "-" + st.session_state.display


# ============================================================
# PROZENT
# ============================================================

def percentage():
    haptic()

    try:
        value = get_number()

        value /= 100

        st.session_state.display = format_number(value)

    except Exception:
        st.session_state.display = "Fehler"


